# ============================================================
# Supabase Proje Ayarlari
# Supabase Dashboard > Settings > API Keys bolumunden alin
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Tarayiciya gonderilmesi guvenli olan anahtar (yeni format: sb_publishable_...)
# Settings > API Keys > "Create new API keys" ile olusturun.
# Eski (legacy) projelerde bunun yerine "anon" (public) key kullanilabilir;
# RLS acisindan islevsel olarak birebir aynidir.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ============================================================
# SADECE SUNUCU TARAFI ICIN.
# Bu satirin adi ASLA "NEXT_PUBLIC_" ile baslamamali - baslarsa
# tarayiciya gonderilir ve tum RLS korumasi devre disi kalir.
# Admin islemleri (firma/kullanici olusturma) ileride bu anahtarla
# server-side (route handler / server action) yapilacak.
# Yeni format: sb_secret_... (eski projelerde service_role key karsiligi)
# ============================================================
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
