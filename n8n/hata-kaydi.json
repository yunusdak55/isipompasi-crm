          "timeout": 15000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "jHSd1FJtTriSFKqE",
          "name": "Supabase account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
